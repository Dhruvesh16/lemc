\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Main quantitative results (test set, mean$\pm $std, 3 seeds). Bold: best trajectory metric per dataset block. Italic: best intent on PIE.}}{6}{table.caption.4}\protected@file@percent }
\newlabel{tab:main}{{II}{6}{Main quantitative results (test set, mean$\pm $std, 3 seeds). Bold: best trajectory metric per dataset block. Italic: best intent on PIE}{table.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces PIE ADE across all compensation conditions (3 seeds). Fixed ORB stays with the baseline cluster, while all learned LEMC variants are substantially worse. This supports the claim that only fixed geometry preserves trajectory quality on PIE.}}{6}{figure.caption.5}\protected@file@percent }
\newlabel{fig:res_pie}{{3}{6}{PIE ADE across all compensation conditions (3 seeds). Fixed ORB stays with the baseline cluster, while all learned LEMC variants are substantially worse. This supports the claim that only fixed geometry preserves trajectory quality on PIE}{figure.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces Physical validity and ego-state stratification. Top: variance-gate pass rate (\%). Bottom: PIE ADE/FDE (px) by ego state (seed 0). Bold: best ADE per state.}}{6}{table.caption.6}\protected@file@percent }
\newlabel{tab:diag}{{III}{6}{Physical validity and ego-state stratification. Top: variance-gate pass rate (\%). Bottom: PIE ADE/FDE (px) by ego state (seed 0). Bold: best ADE per state}{table.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Physical validity diagnostics. (a--b) Fixed ORB passes the standing-pedestrian gate on both datasets; learned methods fail. (c) LEMC correlates with OBD ($R^2{=}0.30$) but does not produce physically valid compensation.}}{7}{figure.caption.7}\protected@file@percent }
\newlabel{fig:res_gate}{{4}{7}{Physical validity diagnostics. (a--b) Fixed ORB passes the standing-pedestrian gate on both datasets; learned methods fail. (c) LEMC correlates with OBD ($R^2{=}0.30$) but does not produce physically valid compensation}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces ORB geometry validation and ego-state stratification. (a) ORB tracks real camera motion without a speed sensor. (b) Fixed ORB is most robust under acceleration/deceleration, where GT speed hurts most.}}{7}{figure.caption.8}\protected@file@percent }
\newlabel{fig:res_orb}{{5}{7}{ORB geometry validation and ego-state stratification. (a) ORB tracks real camera motion without a speed sensor. (b) Fixed ORB is most robust under acceleration/deceleration, where GT speed hurts most}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces JAAD results. (a) Fixed ORB improves all trajectory metrics across seeds. (b--c) Representative overlays show large error reduction after compensation. (d) Validation ADE converges lower with fixed ORB.}}{8}{figure.caption.9}\protected@file@percent }
\newlabel{fig:res_jaad}{{6}{8}{JAAD results. (a) Fixed ORB improves all trajectory metrics across seeds. (b--c) Representative overlays show large error reduction after compensation. (d) Validation ADE converges lower with fixed ORB}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Cross-dataset and intent analysis. (a) Fixed ORB is neutral on PIE and strongly beneficial on JAAD. (b) Intent accuracy rises with ego-motion information, indicating a shortcut in intent evaluation.}}{8}{figure.caption.10}\protected@file@percent }
\newlabel{fig:res_cross}{{7}{8}{Cross-dataset and intent analysis. (a) Fixed ORB is neutral on PIE and strongly beneficial on JAAD. (b) Intent accuracy rises with ego-motion information, indicating a shortcut in intent evaluation}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Qualitative results. (a) Valid ORB flattening of standing-pedestrian drift. (b) Improved PIE trajectory overlay. (c) Correlation without physical validity. (d) Learned residual failure (looping).}}{9}{figure.caption.11}\protected@file@percent }
\newlabel{fig:res_qual}{{8}{9}{Qualitative results. (a) Valid ORB flattening of standing-pedestrian drift. (b) Improved PIE trajectory overlay. (c) Correlation without physical validity. (d) Learned residual failure (looping)}{figure.caption.11}{}}
